{
  "name": "layang",
  "version": "1.1.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "desktop": "concurrently -k \"pnpm run dev\" \"wait-on http://localhost:3000/playground && node scripts/electron-runtime.cjs\"",
    "desktop:win": "pnpm run build && electron-forge make --platform=win32 --targets=@electron-forge/maker-squirrel && electron-forge make --platform=win32 --targets=@electron-forge/maker-zip",
    "desktop:linux": "pnpm run build && electron-forge make --platform=linux",
    "electron:prepare": "node scripts/electron-runtime.cjs --prepare",
    "cli": "node bin/layang.cjs",
    "cli:dist": "node scripts/package-cli-release.cjs",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs && node --test tests/e2e/*.test.cjs && node bin/layang.cjs --help"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@electron-forge/cli": "7.11.1",
    "@electron-forge/maker-deb": "7.11.1",
    "@electron-forge/maker-dmg": "7.11.1",
    "@electron-forge/maker-rpm": "7.11.1",
    "@electron-forge/maker-squirrel": "7.11.1",
    "@electron-forge/maker-wix": "7.11.1",
    "@electron-forge/maker-zip": "7.11.1",
    "@radix-ui/react-slot": "1.2.4",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "25.8.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "concurrently": "9.2.1",
    "electron": "42.1.0",
    "lucide-react": "1.16.0",
    "next": "16.2.6",
    "postcss": "8.5.14",
    "protobufjs": "8.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0",
    "tailwindcss-animate": "1.0.7",
    "typescript": "6.0.3",
    "wait-on": "9.0.10"
  },
  "description": "Layang is a local-first REST, WebSocket, gRPC, gRPC-Web, mock server, benchmark, and documentation workbench with portable workspace folders.",
  "productName": "Layang",
  "license": "MIT",
  "author": "Layang contributors",
  "homepage": "https://github.com/flik-lab/layang#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flik-lab/layang.git"
  },
  "bugs": {
    "url": "https://github.com/flik-lab/layang/issues"
  },
  "keywords": [
    "git-friendly",
    "workspace-folder",
    "api-client",
    "local-first",
    "layang",
    "grpc",
    "grpc-web",
    "rest",
    "websocket",
    "protobuf",
    "api-testing",
    "api-documentation",
    "electron",
    "apisix",
    "developer-portal",
    "landing-page",
    "grpc-tools",
    "proto-registry",
    "multi-tabs",
    "grpc-streaming",
    "console-logging"
  ],
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "bin": {
    "layang": "./bin/layang.cjs"
  },
  "private": true,
  "packageManager": "pnpm@10.12.4+sha512.5ea8b0deed94ed68691c9bad4c955492705c5eeb8a87ef86bc62c74a26b037b08ff9570f108b2e4dbd1dd1a9186fea925e527f141c648e85af45631074680184",
  "pnpm": {
    "overrides": {
      "@tootallnate/once": "^3.0.1",
      "postcss": "^8.5.14",
      "tar": "^7.5.13",
      "tmp": "^0.2.5"
    }
  }
}
