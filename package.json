{
  "name": "layang",
  "version": "1.2.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "prepare:proto-worker": "node scripts/build-proto-catalog-worker.cjs",
    "predev": "pnpm prepare:proto-worker",
    "prebuild": "pnpm prepare:proto-worker",
    "dev": "next dev",
    "build": "next build && node scripts/apply-csp.cjs",
    "start": "next start",
    "desktop": "pnpm prepare:proto-worker && concurrently -k \"pnpm exec next dev --port 12999\" \"wait-on http://localhost:12999/playground && node scripts/electron-runtime.cjs\"",
    "desktop:win": "pnpm run build && electron-forge make --platform=win32 --targets=@electron-forge/maker-squirrel && electron-forge make --platform=win32 --targets=@electron-forge/maker-zip",
    "desktop:linux": "pnpm run build && electron-forge make --platform=linux",
    "electron:prepare": "node scripts/electron-runtime.cjs --prepare",
    "cli": "node bin/layang.cjs",
    "cli:dist": "node scripts/package-cli-release.cjs",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs && node --test tests/e2e/*.test.cjs && node bin/layang.cjs --help",
    "test:electron:smoke": "pnpm prepare:proto-worker && node scripts/electron-window-smoke.cjs",
    "test:soak:v3": "node --expose-gc scripts/benchmarks/soak-v3-repository.cjs",
    "benchmark:v3": "node scripts/benchmarks/benchmark-v3-index.cjs"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "@tanstack/react-virtual": "3.13.13",
    "protobufjs": "8.8.1",
    "codemirror": "6.0.2",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/lang-markdown": "6.5.2",
    "@lezer/highlight": "1.2.3",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-wix": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@radix-ui/react-slot": "1.2.4",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "25.8.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "concurrently": "9.2.5",
    "electron": "42.11.18",
    "lucide-react": "1.16.0",
    "next": "16.4.6",
    "postcss": "8.5.33",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.5",
    "tailwindcss-animate": "1.0.7",
    "typescript": "6.0.3",
    "wait-on": "9.5.1"
  },
  "description": "Layang is a local-first REST, WebSocket, gRPC, gRPC-Web, mock server, benchmark, and documentation workbench with portable workspace folders.",
  "productName": "Layang",
  "license": "MIT",
  "author": "Layang contributors",
  "homepage": "https://github.com/flik-lab/layang#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flik-lab/layang.git"
  },
  "bugs": {
    "url": "https://github.com/flik-lab/layang/issues"
  },
  "keywords": [
    "git-friendly",
    "workspace-folder",
    "api-client",
    "local-first",
    "layang",
    "grpc",
    "grpc-web",
    "rest",
    "websocket",
    "protobuf",
    "api-testing",
    "api-documentation",
    "electron",
    "apisix",
    "developer-portal",
    "landing-page",
    "grpc-tools",
    "proto-registry",
    "multi-tabs",
    "grpc-streaming",
    "console-logging"
  ],
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "bin": {
    "layang": "./bin/layang.cjs"
  },
  "private": true,
  "packageManager": "pnpm@10.12.4+sha512.5ea8b0deed94ed68691c9bad4c955492705c5eeb8a87ef86bc62c74a26b037b08ff9570f108b2e4dbd1dd1a9186fea925e527f141c648e85af45631074680184",
  "pnpm": {
    "overrides": {
      "@tootallnate/once": "^3.0.1",
      "postcss": "^8.5.33",
      "tar": "^7.5.21",
      "tmp": "^0.2.6",
      "@xmldom/xmldom": "^0.9.12",
      "axios": "^1.20.0",
      "follow-redirects": "^1.16.2",
      "form-data": "^4.0.6",
      "joi": "^18.3.1",
      "browserslist": "^4.28.7",
      "fast-uri": "^3.1.7",
      "ip-address": "^10.3.1",
      "nanoid": "^3.3.18",
      "shell-quote": "^1.9.0",
      "source-map-js": "^1.2.2",
      "undici": "^7.30.1",
      "sharp": "^0.35.5",
      "protobufjs@7": "^7.6.1",
      "brace-expansion@1": "^1.1.20",
      "brace-expansion@2": "^2.1.6"
    }
  }
}
